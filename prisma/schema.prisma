// RAINMAKER (Deal-Closer) — Prisma schema
// docs: https://pris.ly/d/prisma-schema
//
// SQLite 제약 메모:
//  - enum 미지원 → String + 앱 레벨 상수(src/lib/constants.ts)로 관리
//  - 배열/Json scalar 미지원 → 다중 값은 관계 테이블 또는 문자열(JSON/구분자) 직렬화
//  - 금액은 원(KRW) 단위 정수(Int)로 저장한다

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ========================= 조직 & 사용자 =========================

/// 팀/회사 단위. 모든 데이터의 최상위 소유자.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  invites         Invite[]
  documents       Document[]
  templates       Template[]
  folders         Folder[]
  catalogItems    CatalogItem[]
  branding        Branding?
  creditWallet    CreditWallet?
  creditTxns      CreditTransaction[]
  emailTemplates  EmailTemplate[]
  promptPresets   PromptPreset[]
  teamMailDomains TeamMailDomain[]
  accounts        Account[]
  contacts        Contact[]
  opportunities   Opportunity[]
  activityLogs    ActivityLog[]

  @@map("organizations")
}

/// 영업 담당자 / 리더 / 관리자
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("SALES_REP") // SALES_REP | LEADER | ADMIN
  avatarUrl String?
  // 직함·연락처는 **개인**의 정보다 (회사 정보는 Branding). 사람마다 다른 값이라
  // 조직 단위로 묶으면 팀원이 늘 때 서로의 값을 덮어쓴다.
  position  String?  // 직함 (예: 팀장, Sales Director)
  phone     String?  // 담당자 연락처 (normalizePhone 으로 정규화해 저장)
  signature String?  // 메일 서명 (발송 시 본문 하단에 추가)
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // 선택한 팀 발신 도메인 (null = 개인 계정으로 발송). 도메인 삭제 시 개인 계정으로 자동 복귀.
  mailDomainId String?
  mailDomain   TeamMailDomain? @relation(fields: [mailDomainId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents     Document[]
  templates     Template[]
  emailAccounts EmailAccount[]
  emailLogs     EmailLog[]
  generations   GenerationRequest[]
  emailTemplates EmailTemplate[] // 본인이 소유한 개인 메일 템플릿
  opportunities  Opportunity[]   // 본인이 Owner 인 영업 기회
  activityLogs   ActivityLog[]   // 본인이 수행자(Actor)인 활동 이력

  @@index([orgId])
  @@index([mailDomainId])
  @@map("users")
}

/// 팀원 초대 (관리자 콘솔 /team/members)
model Invite {
  id        String   @id @default(cuid())
  email     String
  role      String   @default("SALES_REP")
  status    String   @default("PENDING") // PENDING | ACCEPTED | EXPIRED
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([orgId])
  @@map("invites")
}

// ===================== CRM (거래처 · 기회) =====================

/// 거래처(Account) — 영업 대상 회사. 조직 공용 자산이며 Owner 를 두지 않는다. (F-101~103)
/// 담당자는 단일 필드가 아니라 Contact 관계로 갖는다 — 한 회사에 여러 명이 붙는다 (거래처-8).
model Account {
  id           String   @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  companyName  String   // 회사명
  bizRegNo     String?  // 사업자등록번호
  memo         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contacts      Contact[]
  opportunities Opportunity[]

  @@index([orgId])
  @@index([companyName])
  @@map("accounts")
}

/// 거래처 담당자(Contact) — 한 거래처에 여러 명. 목록에는 대표 1명만 노출한다 (거래처-8).
/// - 담당자 0명을 허용한다. 거래처를 먼저 등록하고 담당자를 나중에 넣는 흐름이 자연스럽다.
/// - isPrimary(대표)는 **거래처당 최대 1명**이지만 DB 제약을 두지 않는다.
///   `@@unique([accountId, isPrimary])` 는 "비대표도 1명뿐"이 되어 쓸 수 없고,
///   SQLite 의 부분 유니크 인덱스는 Prisma 스키마로 표현되지 않는다.
///   그래서 규칙은 앱 레벨이다 — 판정은 src/lib/contact.ts 순수 함수, 저장은 한 트랜잭션이다
///   (대표 지정과 기존 대표 해제를 두 번의 update 로 나누면 중간에 대표가 2명이 된다).
/// - orgId 는 Account 를 거치지 않고도 조직 스코프로 조회하기 위한 것이며,
///   다른 모델과 같이 Organization FK 를 건다(값이 떠도는 문자열이 되지 않게).
model Contact {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String   // 담당자명
  position  String?  // 직책
  phone     String?  // 핸드폰 번호
  email     String?  // 담당자 이메일
  isPrimary Boolean  @default(false) // 대표 담당자 (목록 노출 대상)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([accountId])
  @@map("contacts")
}

/// 영업 기회(Opportunity) — 파이프라인의 단위. (F-111~117)
/// - stage: INITIAL(초기) | PROPOSAL(제안) | NEGOTIATION(검토/협상) | WON(수주) | LOST(실주)
///   문서 발송 시 자동 전이한다(F-113). 전이 규칙은 src/lib/opportunity-stage.ts 한 곳에 모은다.
/// - lostReason: LOST 일 때만 채운다(F-117). 이탈률 통계(F-405)의 분류 축이 된다.
/// - previousOpportunityId: 수주 후 자동 생성되는 "다음 기회"가 직전 기회를 가리킨다(F-115·F-306).
/// - expectedAmount 는 **입력값이 아니라 확정 문서에서 파생된 값**이다 (기회-6).
model Opportunity {
  id                  String    @id @default(cuid())
  orgId               String
  org                 Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  accountId           String
  account             Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ownerId             String
  owner               User      @relation(fields: [ownerId], references: [id])
  name                String    // 기회명
  stage               String    @default("INITIAL")
  /// 예상 금액 (KRW 정수) — **확정 문서(confirmedDocument)의 금액을 복제한 파생 값**이다.
  /// 사용자가 직접 입력하지 않으며, 확정 문서가 없으면 0 이다 (기회-6 ④).
  /// 집계(파이프라인·대시보드·캘린더)가 기회 행만 읽고도 합계를 낼 수 있도록 비정규화해 둔다 —
  /// 매번 문서를 조인해 확정 문서를 다시 고르면 목록 한 화면의 조인이 기회 수만큼 늘어난다.
  /// 쓰기는 `src/lib/opportunity-amount.ts` 한 곳뿐이다.
  expectedAmount      Int       @default(0)
  /// 예상 금액의 출처가 되는 **확정 문서 1건** (기회-6). null 이면 확정 문서 없음 → 금액 0.
  /// `Document.isConfirmed` 플래그 대신 여기에 FK 를 두는 이유는, 기회당 확정 문서가
  /// **구조적으로 1건**임이 보장되어 "여러 문서가 동시에 확정" 상태가 만들어질 수 없기 때문이다.
  /// @unique 는 한 문서가 두 기회의 금액을 동시에 좌우하지 못하게 막는다
  /// (previousOpportunityId 와 같은 선례의 named relation 이다).
  /// 문서가 지워지면 SetNull 로 끊기고, 라우트가 곧바로 재판정해 금액을 다시 맞춘다.
  confirmedDocumentId String?   @unique
  confirmedDocument   Document? @relation("ConfirmedDocument", fields: [confirmedDocumentId], references: [id], onDelete: SetNull)
  /// 확정 문서를 **사용자가 직접 골랐는지** (기회-6 ③). true 면 자동 판정에서 제외(잠금)된다.
  /// 잠금 여부를 다른 상태에서 추론하지 않고 별도 컬럼으로 두는 이유: 자동 판정 결과와 사용자의
  /// 선택이 우연히 같을 수 있어, 플래그가 없으면 "내가 고른 것"과 "마침 그렇게 뽑힌 것"을
  /// 구분할 수 없다 — 그 상태에서 문서가 하나 추가되면 사용자의 선택이 조용히 뒤집힌다.
  isConfirmedDocumentPinned Boolean @default(false)
  expectedCloseDate   DateTime? // 예상 마감일
  actualCloseDate     DateTime? // 실제 수주/실주 확정일
  lostReason          String?   // 실주 사유 (LOST 일 때만)
  memo                String?
  previousOpportunityId String?  @unique
  previousOpportunity   Opportunity?  @relation("OpportunityChain", fields: [previousOpportunityId], references: [id], onDelete: SetNull)
  nextOpportunity       Opportunity?  @relation("OpportunityChain")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  documents    Document[]
  activityLogs ActivityLog[]

  @@index([orgId])
  @@index([accountId])
  @@index([ownerId])
  @@index([stage])
  @@index([expectedCloseDate])
  @@map("opportunities")
}

/// 활동 이력(ActivityLog) — 기회 타임라인의 원천. (F-114)
/// eventType 예: OPPORTUNITY_CREATED · STAGE_CHANGED · DOCUMENT_CREATED · DOCUMENT_SENT · WON · LOST
/// detail 은 이벤트별 부가 정보(이전/이후 단계 등)를 JSON 문자열로 직렬화해 담는다 (SQLite Json 미지원).
model ActivityLog {
  id            String   @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  actorId       String
  actor         User     @relation(fields: [actorId], references: [id])
  eventType     String
  detail        String?
  occurredAt    DateTime @default(now())

  @@index([orgId])
  @@index([opportunityId])
  @@index([actorId])
  @@map("activity_logs")
}

// ============================ 문서 ============================

/// 견적서/계약서/NDA/제안서 등 영업 문서
model Document {
  id          String   @id @default(cuid())
  title       String
  type        String   @default("QUOTE")  // QUOTE | CONTRACT | NDA | PROPOSAL
  status      String   @default("DRAFT")  // DRAFT | SENT | COMPLETED | VOID(폐기)
  clientName  String?                     // 거래처명
  amount      Int      @default(0)        // 총액(KRW 정수)
  currency    String   @default("KRW")
  contentJson String?                     // 에디터 본문(JSON 직렬화)
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  // 문서 분류용 폴더(선택). null 이면 "미분류". 폴더 삭제 시 문서는 미분류로 내려간다.
  folderId    String?
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  // [사용 안 함] 팀 공용/개인 문서함 파티션이었다. 문서함을 하나로 합치면서 화면·라우트에서
  // 걷어냈고(기본값 false 로만 남는다), 팀 워크스페이스가 실제로 필요해질 때 되살릴 자리로만 둔다.
  // 조회 조건·쓰기 입력으로 쓰지 않는다 — 화면에 없는 두 번째 문서함이 데이터에만 생긴다.
  isCommon    Boolean  @default(false)

  // 연결된 영업 기회(선택). 기회 상세의 문서 목록·발송 시 단계 자동 전이(F-113)의 기준이 된다.
  // 기회 없이도 문서를 만들 수 있다(빠른 초안) — 통계·타임라인은 미연결 문서를 별도로 다룬다.
  // 한 문서는 최대 한 기회에만 붙는다 — 그래야 문서 하나가 두 기회의 금액을 좌우하지 않는다 (기회-5).
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  // 이 문서를 예상 금액의 근거(확정 문서)로 삼은 기회 (기회-6). 역방향이며 최대 1건이다.
  // 아래 `isConfirmed`(버전 확정본, F-214)와는 다른 개념이다 — 저쪽은 "이 버전이 확정본인가",
  // 이쪽은 "어느 기회가 이 문서를 금액의 근거로 삼았는가"다.
  confirmedFor  Opportunity? @relation("ConfirmedDocument")

  // ───── 표준 양식 · 버전 이력 (PRD F-211 · F-213 · F-214) ─────
  /// 이 문서를 생성할 때 소스로 사용한 표준 양식. 양식이 삭제되면 링크만 끊긴다.
  templateId  String?
  template    Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// 버전 번호(1부터). 같은 rootId 묶음 안에서 1씩 증가한다.
  version     Int      @default(1)
  /// 확정본 플래그 — 같은 묶음에서 여러 버전을 동시에 확정본으로 지정할 수 있다(F-214).
  isConfirmed Boolean  @default(false)
  /// 버전 묶음 키 = 최초 버전(v1) 문서의 id. null 이면 이 문서가 v1(묶음의 뿌리)이다.
  rootId      String?
  root        Document?  @relation("DocumentVersions", fields: [rootId], references: [id], onDelete: Cascade)
  versions    Document[] @relation("DocumentVersions")
  /// 계약서 생성 시 소스로 지정한 확정 견적서(F-213).
  sourceDocumentId String?
  sourceDocument   Document?  @relation("DocumentSource", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  derivedDocuments Document[] @relation("DocumentSource")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items        DocumentItem[]
  emailLogs    EmailLog[]
  generation   GenerationRequest?
  referencedIn GenerationReference[] // 이 문서를 참고 자료로 사용한 생성 요청들

  @@index([orgId])
  @@index([authorId])
  @@index([status])
  @@index([folderId])
  @@index([templateId])
  @@index([rootId])
  @@index([opportunityId])
  @@map("documents")
}

// ===================== 표준 양식 (PRD 4.2.1) =====================

/// 표준 양식 — 기존에 쓰던 양식 파일을 업로드하고(F-202), 자연어 프롬프트로
/// AI 가 초기 표준 문서를 세팅한 결과(F-203)와 변수 필드 정의(F-204)를 담는다.
/// 문서 생성 시 이 양식을 불러와 값만 채운다(F-211 · F-212).
model Template {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  name        String
  type        String   @default("QUOTE")   // QUOTE | CONTRACT | NDA | PROPOSAL
  /// COMMON = 공용 문서함(팀 표준 양식) | PERSONAL = 개인 문서함 양식
  scope       String   @default("COMMON")
  description String?
  /// AI 세팅 결과 — 에디터 블록 캔버스 문서(EditorDoc JSON 직렬화)
  contentJson String?
  /// 세팅에 사용한 자연어 프롬프트 (재세팅·감사 추적용)
  prompt      String?
  /// 업로드한 원본 양식 파일 (F-202) — 다시 내려받거나 재세팅할 때 사용
  sourceFileName String?
  sourceMimeType String?
  sourceSize     Int?
  sourceData     Bytes?
  /// 공용 양식을 개인 문서함으로 복제(Fork)한 경우의 원본 양식 (5장 F-522 대비)
  forkedFromId String?
  forkedFrom   Template?  @relation("TemplateFork", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks        Template[] @relation("TemplateFork")

  variables TemplateVariable[]
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([type])
  @@index([forkedFromId])
  @@map("templates")
}

/// 양식별 변수 필드 정의 (F-204) — 고객사명·담당자명·품목·단가·계약기간 등
/// 문서 생성 시 AI 가 채워야 하는 값의 목록. key 는 양식 안에서 고유하다.
model TemplateVariable {
  id         String   @id @default(cuid())
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// 치환 키 (예: 고객사명, 담당자명, 계약기간)
  key        String
  /// 화면 표시 라벨
  label      String
  /// 예시값 (AI 프롬프트 힌트 · 입력 placeholder)
  sample     String?
  /// 필수 여부 — 비어 있으면 생성 결과에 경고를 표시한다
  required   Boolean  @default(false)
  sortOrder  Int      @default(0)

  @@unique([templateId, key])
  @@index([templateId])
  @@map("template_variables")
}

/// 문서 라인 아이템 (견적 항목)
model DocumentItem {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  name        String
  description String?
  quantity    Int      @default(1)
  unitPrice   Int      @default(0)
  amount      Int      @default(0)
  sortOrder   Int      @default(0)

  @@index([documentId])
  @@map("document_items")
}

/// 문서 분류용 폴더 (다단계 트리). parentId 로 자기 자신을 참조해 중첩 폴더를 구성한다.
/// 상위 폴더 삭제 시 하위 폴더도 함께 삭제(Cascade)되고, 각 폴더의 문서는 미분류로 내려간다.
model Folder {
  id        String   @id @default(cuid())
  name      String
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // [사용 안 함] 소속 문서함 파티션이었다 (Document.isCommon 과 짝). 문서함 통합으로 미사용.
  isCommon  Boolean  @default(false)
  parentId  String?
  parent    Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderTree")
  documents Document[]
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([parentId])
  @@map("folders")
}

// ==================== 카탈로그(마스터 데이터) ====================

/// 상품/서비스 카탈로그 (관리자 콘솔 /catalog)
model CatalogItem {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category    String
  name        String
  sku         String?
  unit        String   @default("EA")
  unitPrice   Int      @default(0)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId])
  @@index([category])
  @@map("catalog_items")
}

// ====================== 메일 연동 & 발송 ======================

/// Gmail/Outlook 연동 계정 (/settings/email)
model EmailAccount {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String   // GMAIL | OUTLOOK
  email     String
  isDefault Boolean  @default(false)
  status    String   @default("CONNECTED") // CONNECTED | DISCONNECTED
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_accounts")
}

/// 팀(조직) 단위 발신 메일 도메인 — 관리자 콘솔(/settings/mail-domain)에서 등록·인증한다.
/// 담당자는 개인 연동 계정 대신 이 도메인 기반 주소(<핸들>@<domain>)로 발신하도록 선택할 수 있다.
/// - status: PENDING(인증 대기) → VERIFIED(인증됨, 데모는 관리자 수동 확인). VERIFIED 만 담당자가 선택 가능.
/// - isDefault: 팀 권장 발신 도메인(조직당 1개). 담당자 온보딩 시 안내에 사용.
model TeamMailDomain {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  domain    String   // 호스트명만 저장 (예: "rainmaker.ai", @ 제외)
  label     String?  // 표시용 별칭 (예: "회사 공식 도메인")
  status    String   @default("PENDING") // PENDING | VERIFIED
  isDefault Boolean  @default(false)
  // 팀 도메인 발송 시 참조(CC) 기본 목록 (세미콜론 구분). 등록 시 영업팀 전원으로 자동 채움, 관리자 편집.
  defaultCc String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]   // 이 도메인을 발신 도메인으로 선택한 담당자들

  @@unique([orgId, domain])
  @@index([orgId])
  @@map("team_mail_domains")
}

/// 이메일 발송 이력 (/sender/:documentId)
model EmailLog {
  id             String   @id @default(cuid())
  documentId     String
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation(fields: [senderId], references: [id])
  recipients     String   // 세미콜론(;) 구분 다중 수신자
  subject        String
  body           String?
  attachmentName String?
  // SENT | SKIPPED | FAILED — 전송 어댑터(`@/lib/mailer`)의 결과를 그대로 옮긴다 (F-233).
  // SKIPPED = 자격증명 없는 개발 환경 · MAIL_DRY_RUN 으로 **의도적으로 보내지 않은** 건.
  // 값 목록·라벨은 `@/lib/email-log` 의 EMAIL_LOG_STATUSES 가 단일 소스다.
  status         String   @default("SENT")
  sentAt         DateTime @default(now())
  // ── 오픈 트래킹 (F-234) ──
  // trackingId: 본문에 삽입하는 추적 픽셀 URL 의 식별자. 수신자가 본문을 열면 서버가 openedAt 을 기록한다.
  trackingId     String?  @unique
  openedAt       DateTime? // 최초 열람 시각 (null = 미열람)
  openCount      Int      @default(0)

  @@index([documentId])
  @@map("email_logs")
}

/// 메일 발송 템플릿 (제목·본문 저장 → 발송 화면·관리 페이지에서 불러오기)
/// - ownerId 가 null 이면 팀 공용(조직 전체 공유), 값이 있으면 개인 전용이다.
/// - subject·body 의 {{거래처}}·{{담당자}}·{{문서제목}}·{{문서종류}}·{{총액}} 은 발송 시 현재 문서·담당자 값으로 치환한다.
model EmailTemplate {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ownerId   String? // null = 팀 공용, 값 있으면 개인 소유자
  owner     User?        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  subject   String
  body      String
  recipientName String? // 기본 담당자명 — 불러오면 발송 폼 담당자명에 자동 입력 + {{담당자}} 치환
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([orgId])
  @@index([ownerId])
  @@map("email_templates")
}

/// 지시문 예시 프리셋 — 문서 생성 화면 오른쪽 레일의 "이렇게 말해보세요" (생성 UI).
/// **기본 예시 셋은 코드(`src/lib/prompt-preset.ts`)에 있고 이 표에 넣지 않는다** —
/// 표에 넣으면 지워질 수 있고, 지워진 뒤에는 새 담당자가 무엇을 어떻게 적는지 배울 곳이
/// 없어진다. 이 표는 **사용자가 더한 것만** 담는다.
/// EmailTemplate 의 팀 공용 프리셋과 같은 판단으로 조직 단위다 — 예시 지시문은 "우리 팀이
/// 이렇게 쓴다" 는 관행이라 사람마다 따로 쌓을 이유가 없다. 개인 프리셋이 필요해지면
/// EmailTemplate.ownerId 처럼 옵셔널 소유자를 더한다.
model PromptPreset {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// 지시문 본문. 줄바꿈을 포함할 수 있다(여러 줄 지시문)
  text      String
  /// 레일에 그리는 순서. 기본 예시 뒤에 이 순서로 붙는다
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@map("prompt_presets")
}

// ======================= 크레딧 & 과금 =======================

/// 조직별 크레딧 잔액 (문서 생성 시 차감)
model CreditWallet {
  id        String   @id @default(cuid())
  orgId     String   @unique
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("credit_wallets")
}

/// 크레딧 충전/사용 내역 (관리자 콘솔 /billing)
model CreditTransaction {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  amount    Int      // +충전 / -사용
  type      String   // CHARGE | USAGE
  reason    String?
  createdAt DateTime @default(now())

  @@index([orgId])
  @@map("credit_transactions")
}

// ===================== AI 문서 생성 요청 =====================

/// AI 대화형 문서 생성 요청 (/generator)
model GenerationRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  prompt      String
  status      String    @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  creditsUsed Int       @default(0)
  documentId  String?   @unique
  document    Document? @relation(fields: [documentId], references: [id])
  createdAt   DateTime  @default(now())

  attachments Attachment[]
  references  GenerationReference[]

  @@index([userId])
  @@map("generation_requests")
}

/// AI 문서 생성 시 첨부한 원본 파일 (협력사 견적서 등)
/// - data: 원본 바이트(BLOB). 나중에 다운로드/열람 가능.
/// - extractedText: 엑셀/CSV 의 표 데이터를 텍스트로 추출한 값(있을 때만).
model Attachment {
  id            String   @id @default(cuid())
  generationId  String
  generation    GenerationRequest @relation(fields: [generationId], references: [id], onDelete: Cascade)
  fileName      String
  mimeType      String
  size          Int      // 바이트 단위 크기
  data          Bytes    // 원본 파일 바이트
  extractedText String?  // 엑셀/CSV 추출 텍스트 (PDF/이미지는 null)
  createdAt     DateTime @default(now())

  @@index([generationId])
  @@map("attachments")
}

/// AI 문서 생성 시 참고 자료로 가져온 보관함 문서 (기존 견적서 등)
/// GenerationRequest 와 기존 Document 를 잇는 조인 테이블.
model GenerationReference {
  id           String   @id @default(cuid())
  generationId String
  generation   GenerationRequest @relation(fields: [generationId], references: [id], onDelete: Cascade)
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([generationId, documentId])
  @@index([generationId])
  @@index([documentId])
  @@map("generation_references")
}

// ========================= 브랜딩 =========================

/// 조직 브랜딩 설정 (관리자 콘솔 /settings/branding)
model Branding {
  id           String   @id @default(cuid())
  orgId        String   @unique
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  companyName  String?
  logoUrl      String?
  // 인감(직인) 이미지. 로고와 같은 방식으로 dataUrl 을 그대로 담는다 — 별도 파일 저장소가
  // 없고, 에디터 이미지 블록도 dataUrl 로 본문에 넣는다 (상한: MAX_BRANDING_IMAGE_BYTES).
  stampUrl     String?
  // 문서 공급자 정보로 쓰이는 **회사** 값들 (담당자 개인 값은 User.position·User.phone).
  ceoName      String?  // 대표자명
  bizRegNo     String?  // 사업자등록번호 (normalizeBizRegNo 로 000-00-00000 정규화)
  address      String?  // 회사 주소
  phone        String?  // 대표 연락처 (normalizePhone 으로 정규화)
  primaryColor String   @default("#4F46E5")
  updatedAt    DateTime @updatedAt

  @@map("brandings")
}

// ================= 정책 (기획서 정책 라이브러리) =================

/// 기획서 정책 라이브러리 (24개 정책: AUTH_*, VAL_*, FORM_*, STATE_*, legal-* 등)
model Policy {
  id          String   @id @default(cuid())
  code        String   @unique
  scope       String   @default("project")
  description String
  createdAt   DateTime @default(now())

  @@map("policies")
}
