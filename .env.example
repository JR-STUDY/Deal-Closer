# RAINMAKER (Deal-Closer) 환경 변수 예시
# 이 파일을 복사해 .env 로 만들어 사용하세요: cp .env.example .env

# ── 데이터베이스 (SQLite) ──
# prisma.config.ts 와 런타임(src/lib/db.ts)이 모두 이 값을 사용합니다.
# 프로젝트 루트 기준 상대 경로입니다.
DATABASE_URL="file:./dev.db"

# ── AI 문서 생성 ──
# 문서 생성·양식 세팅·부분 재작성이 모두 실제 LLM API 를 직접 호출합니다.
# Claude(Anthropic) 와 GPT(OpenAI) 둘 중 하나를 쓸 수 있습니다 — 키를 넣은 쪽이 선택됩니다.
# 키가 없으면 관련 API 가 503(AI 연동이 설정되지 않았습니다)을 반환합니다.

# Claude 를 쓸 경우 — 반드시 콘솔에서 발급한 API 키(sk-ant-api…)여야 합니다.
#   Claude Code 로그인 토큰(sk-ant-oat…)은 Messages API 에서 쓸 수 없습니다.
#   발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# GPT 를 쓸 경우 — OpenAI 플랫폼 키(sk-… / sk-proj-…)
#   발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# (선택) 조직·프로젝트를 분리해 쓰는 OpenAI 계정이면 지정합니다.
# OPENAI_ORG_ID=""
# OPENAI_PROJECT_ID=""

# (선택) 프로바이더 강제 지정: anthropic | openai
#   생략하면 ① AI_MODEL_GENERATE 모델명 → ② 넣어둔 키 순서로 자동 판별합니다.
# AI_PROVIDER="openai"

# (선택) 용도별 모델 오버라이드 — 모델명만 바꿔도 프로바이더가 따라갑니다.
# AI_MODEL_GENERATE: 문서 초안 생성 · 양식 AI 세팅 · 부분 재작성
# AI_MODEL_BATCH:    변수 필드 추출 등 경량·반복 작업
#   기본값 — Claude: claude-opus-5 / claude-sonnet-5
#            GPT:    gpt-5.6-sol  / gpt-5.6-terra
# AI_MODEL_GENERATE="gpt-5.6-sol"
# AI_MODEL_BATCH="gpt-5.6-terra"
