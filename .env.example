# RAINMAKER (Deal-Closer) 환경 변수 예시
# 이 파일을 복사해 .env 로 만들어 사용하세요: cp .env.example .env

# ── 데이터베이스 (SQLite) ──
# prisma.config.ts 와 런타임(src/lib/db.ts)이 모두 이 값을 사용합니다.
# 프로젝트 루트 기준 상대 경로입니다.
DATABASE_URL="file:./dev.db"

# ── (선택) AI 문서 생성 ──
# MVP 단계에서는 목업 응답을 사용하므로 비워두어도 됩니다.
# 실제 연동 시 Anthropic API 키를 설정하세요.
# ANTHROPIC_API_KEY=""

# ── 메일 발송 (src/lib/mailer.ts — Resend) ──
# 비워두면 개발 환경에서는 전송을 건너뛰고 로그만 남깁니다(안전한 개발 모드).
# 운영(NODE_ENV=production)에서는 키가 없으면 발송이 실패로 처리됩니다.
# 키는 https://resend.com 대시보드에서 발급합니다. 절대 커밋하지 마세요.
# RESEND_API_KEY=""

# 발신 주소·표시 이름 (발송 시 개별 지정하지 않으면 이 값을 씁니다).
# Resend 에 DNS 인증된 도메인이어야 발송됩니다 — 관리자 콘솔의 팀 발신 도메인과 같은 도메인을 쓰세요.
# MAIL_FROM_ADDRESS="no-reply@example.com"
# MAIL_FROM_NAME="RAINMAKER"

# true 로 두면 키가 있어도 실제로 보내지 않고 건너뜁니다 (스테이징·리허설용).
# MAIL_DRY_RUN="false"

# 전송 재시도·타임아웃 (미설정 시 3회 시도 / 10초). 상한은 5회 / 60초입니다.
# MAIL_MAX_ATTEMPTS="3"
# MAIL_TIMEOUT_MS="10000"
