# RAINMAKER (Deal-Closer) 환경 변수 예시
# 이 파일을 복사해 .env 로 만들어 사용하세요: cp .env.example .env

# ── 데이터베이스 (SQLite) ──
# prisma.config.ts 와 런타임(src/lib/db.ts)이 모두 이 값을 사용합니다.
# 프로젝트 루트 기준 상대 경로입니다.
DATABASE_URL="file:./dev.db"

# ── AI 문서 생성 ──
# 문서 생성·양식 세팅·부분 재작성이 모두 실제 LLM API 를 직접 호출합니다.
# Claude(Anthropic) · GPT(OpenAI) · Gemini(Google) 를 지원하며,
# **키를 넣은 프로바이더의 모델만** 사용자 화면의 모델 선택기에 나타납니다.
# 여러 개를 넣으면 사용자가 화면에서 골라 쓸 수 있습니다.
# 하나도 없으면 관련 API 가 503(AI 연동이 설정되지 않았습니다)을 반환합니다.

# Claude 를 쓸 경우 — 반드시 콘솔에서 발급한 API 키(sk-ant-api…)여야 합니다.
#   Claude Code 로그인 토큰(sk-ant-oat…)은 Messages API 에서 쓸 수 없습니다.
#   발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# GPT 를 쓸 경우 — OpenAI 플랫폼 키(sk-… / sk-proj-…)
#   발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# (선택) 조직·프로젝트를 분리해 쓰는 OpenAI 계정이면 지정합니다.
# OPENAI_ORG_ID=""
# OPENAI_PROJECT_ID=""

# Gemini 를 쓸 경우 — Google AI Studio 키(AIza…)
#   발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# (선택) 프로바이더 강제 지정: anthropic | openai | google | mock
#   사용자가 화면에서 모델을 고르지 않았을 때의 기본값을 정합니다.
#   생략하면 ① AI_MODEL_GENERATE 모델명 → ② 넣어둔 키 순서로 자동 판별합니다.
# AI_PROVIDER="openai"

# mock = 로컬 검증용. 실제 LLM 을 호출하지 않고 스키마에 맞는 응답을 즉시 돌려줍니다.
#   키·비용 없이 생성→에디터→버전→크레딧 경로가 이어지는지 확인할 때 씁니다.
#   문장 품질·추론 정확도는 검증되지 않습니다 — 그건 실제 키로 확인하세요.
#   자동 선택되지 않으며, 프로덕션 빌드(NODE_ENV=production)에서는 거부됩니다.
# AI_PROVIDER="mock"

# (선택) 용도별 모델 오버라이드 — 모델명만 바꿔도 프로바이더가 따라갑니다.
# AI_MODEL_GENERATE: 문서 초안 생성 · 양식 AI 세팅 · 부분 재작성
# AI_MODEL_BATCH:    변수 필드 추출 등 경량·반복 작업
#   AI_MODEL_GENERATE 는 화면에서 모델을 고르지 않았을 때의 기본값입니다.
#   AI_MODEL_BATCH 는 변수 필드 추출 전용이며 선택기가 없습니다.
#   기본값 — Claude: claude-opus-5          / claude-sonnet-5
#            GPT:    gpt-5.6-sol            / gpt-5.6-terra
#            Gemini: gemini-3.1-pro-preview / gemini-3.6-flash
# AI_MODEL_GENERATE="gemini-3.6-flash"
# AI_MODEL_BATCH="gemini-3.5-flash-lite"
